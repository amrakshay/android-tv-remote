# The wrapper jar is checked in on purpose, so a clone can build without Gradle installed first.
!gradle/wrapper/gradle-wrapper.jar

# A paired client certificate is a credential the TV trusts. Never commit one.
# The two under protocol/src/test/resources are throwaway fixtures with no private
# key, used to pin the pairing hash against the reference implementation.
*.pem
!protocol/src/test/resources/*.pem
creds/

